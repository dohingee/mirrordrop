        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트 Wi-Fi나 공유기의 \"AP 격리\"(기기끼리 서로 못 보게 막는 설정)가 켜져 있으면 TV를 찾을 수 없어요."
          }
        }
      }
