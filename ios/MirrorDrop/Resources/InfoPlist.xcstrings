{
  "sourceLanguage" : "ko",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorDrop may use Bluetooth to find nearby TVs (Google Cast devices)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처의 TV(Google Cast 기기)를 찾는 데 블루투스를 쓸 수 있습니다."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorDrop uses the local network to find TVs (Google Cast devices) on the same Wi-Fi and send your iPhone screen to them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi에 있는 TV(Google Cast 기기)를 찾고, iPhone 화면을 그 TV로 보내기 위해 로컬 네트워크를 사용합니다."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only to show ads that fit your interests. Every feature works the same if you don't allow it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맞춤 광고를 보여 주는 데만 씁니다. 허용하지 않아도 모든 기능을 그대로 쓸 수 있어요."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
